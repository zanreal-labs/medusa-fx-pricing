{
  "name": "@zanreal/medusa-fx-pricing",
  "version": "0.2.1",
  "description": "Medusa v2 plugin that derives USD/EUR variant prices from a native PLN selling price using the NBP (Polish central bank) table A mid rate, as soon as that price changes and again daily, with a configurable margin and manual-override protection.",
  "keywords": [
    "currency",
    "exchange-rates",
    "fx",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-v2",
    "nbp",
    "plugin",
    "poland",
    "pricing"
  ],
  "homepage": "https://zanreal.com/docs/oss/medusa-fx-pricing",
  "bugs": {
    "url": "https://github.com/zanreal-labs/medusa-fx-pricing/issues"
  },
  "license": "MIT",
  "author": "ZanReal <opensource@zanreal.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/medusa-fx-pricing.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    ".medusa/server",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "medusa plugin:build",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/eslint-plugin": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "@swc/core": "^1.16.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "react-i18next": "^13.5.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.1"
}
